<Window x:Class="CanvasDashboard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="640" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="WindowTitleLabel" Grid.Row="0" Text="设置" FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,16" Foreground="{DynamicResource AppTextPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 外观 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionHeaderStyle}" Text="外观" />
                        <RadioButton x:Name="ThemeSystemRadio" GroupName="Theme" Tag="system" Margin="0,4"
                                     Content="跟随系统" Checked="ThemeRadio_Checked" />
                        <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Tag="light" Margin="0,4"
                                     Content="浅色" Checked="ThemeRadio_Checked" />
                        <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Tag="dark" Margin="0,4"
                                     Content="深色" Checked="ThemeRadio_Checked" />
                    </StackPanel>
                </Border>

                <!-- 语言 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="LanguageHeader" Style="{StaticResource SectionHeaderStyle}" Text="语言" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangZhRadio" GroupName="Language" Tag="zh" Margin="0,0,20,0"
                                         Content="中文" Checked="LanguageRadio_Checked" />
                            <RadioButton x:Name="LangEnRadio" GroupName="Language" Tag="en"
                                         Content="English" Checked="LanguageRadio_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 账号 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AccountHeader" Style="{StaticResource SectionHeaderStyle}" Text="账号" />

                        <TextBlock x:Name="BaseUrlLabelText" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="Canvas 网址" />
                        <TextBlock x:Name="BaseUrlValueText" Margin="0,2,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Text="(未设置)" />

                        <Button x:Name="ReconfigureButton" Content="重新选课 / 更换 Token"
                                HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,10"
                                Click="ReconfigureButton_Click" />
                        <Button x:Name="LogoutButton" Content="退出登录"
                                HorizontalAlignment="Left" Padding="14,7"
                                Foreground="{DynamicResource AppDangerBrush}"
                                Click="LogoutButton_Click" />
                    </StackPanel>
                </Border>

                <!-- 其它 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="OtherHeader" Style="{StaticResource SectionHeaderStyle}" Text="其它" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SyncNowButton" Content="立即同步" Padding="14,7" Margin="0,0,10,0"
                                    Click="SyncNowButton_Click" />
                            <Button x:Name="OpenLogsButton" Content="打开日志文件夹" Padding="14,7"
                                    Click="OpenLogsButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CalendarNoteText" Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="作业日历文件：项目目录下的 canvas_assignments.ics，导入到 Outlook / Google 日历就能看到截止日期" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionHeaderStyle}" Text="关于" />
                        <TextBlock x:Name="AboutBodyText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="Canvas 作业追踪 · Windows 版" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton" Grid.Row="2" Content="关闭" Padding="18,8"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseButton_Click" />
    </Grid>
</Window>
