<Window x:Class="CanvasDashboard.Views.AlarmEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒时间" Height="420" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppContentBackgroundBrush}">
    <StackPanel Margin="24" HorizontalAlignment="Center">
        <TextBlock x:Name="TitleLabel" Text="设置提醒时间" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />

        <!-- 时:分 —— 每个数字旁边一对 ▲▼ 小按钮增减，效果上等同于 Mac 版的滚轮式数字选择器 -->
        <Grid Margin="0,20,0,4" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HourText" Text="08" FontSize="40" FontWeight="SemiBold"
                           Width="60" TextAlignment="Center"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Content="▲" Width="24" Height="20" Padding="0" Click="HourUp_Click" />
                    <Button Content="▼" Width="24" Height="20" Padding="0" Margin="0,2,0,0" Click="HourDown_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text=":" FontSize="40" FontWeight="SemiBold" Margin="6,0"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="MinuteText" Text="00" FontSize="40" FontWeight="SemiBold"
                           Width="60" TextAlignment="Center"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Content="▲" Width="24" Height="20" Padding="0" Click="MinuteUp_Click" />
                    <Button Content="▼" Width="24" Height="20" Padding="0" Margin="0,2,0,0" Click="MinuteDown_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Text="重复" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,8"
                   Foreground="{DynamicResource AppTextSecondaryBrush}" />

        <StackPanel x:Name="DayButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" />

        <StackPanel x:Name="PresetButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" />

        <CheckBox x:Name="EnabledCheckBox" Content="启用" IsChecked="True"
                  HorizontalAlignment="Center" Margin="0,18,0,0"
                  Foreground="{DynamicResource AppTextPrimaryBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="DeleteButton" Content="删除" Width="80" Margin="0,0,8,0"
                    Click="DeleteButton_Click" Visibility="Collapsed" />
            <Button Content="保存" Width="80" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
