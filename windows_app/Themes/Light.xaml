    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#FFECECEF" />
    <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF6E6E73" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF0A84FF" />
